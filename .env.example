# ============================================================
# Gerador de Contratos IA Infinito — modelo de variáveis
# Copie para .env (`cp .env.example .env`) e ajuste os valores.
# O arquivo .env real é ignorado pelo Git e NUNCA deve ser commitado.
# ============================================================

# Servidor HTTP
PORT=8080
ENV=development

# URL pública do sistema (referência de deploy; o servidor não lê esta variável hoje)
APP_BASE_URL=https://contratos.iainfinito.com.br

# Banco de Dados SQLite (WAL)
DB_PATH=./data/contracts.db

# Armazenamento local de PDFs (fallback quando o S3 não está configurado)
LOCAL_PDF_DIR=./data/pdfs

# ------------------------------------------------------------
# MinIO / S3
# Na stack do Coolify, S3_ENDPOINT aponta internamente para http://minio:9000
# e o app herda as credenciais de MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
# Em desenvolvimento local com MinIO rodando na máquina: http://localhost:9000
# ------------------------------------------------------------
MINIO_ROOT_USER=admin_iainfinito
MINIO_ROOT_PASSWORD=TROCAR_POR_SENHA_FORTE_MIN_8_CHARS
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=contratos
S3_REGION=us-east-1
S3_ACCESS_KEY=admin_iainfinito
S3_SECRET_KEY=TROCAR_POR_SENHA_FORTE_MIN_8_CHARS
S3_USE_PATH_STYLE=true

# Pool Chromium (chromedp) — quantidade de browsers simultâneos
PDF_POOL_SIZE=2
# Caminho do Chrome/Chromium; vazio = detecção automática (Windows) ou CHROME_BIN
CHROME_PATH=

# Fuso horário do container (datas padrão do contrato)
TZ=America/Campo_Grande

# Link de Pagamento Padrão (InfinitePay)
DEFAULT_PAYMENT_LINK=https://link.infinitepay.io/joel-quintana/VC1DLTAtUg-YfLpjLenlZ-1500,00

# Dados padrão da CONTRATADA (IA Infinito) — opcionais / sobrescrevíveis
CONTRATADA_RAZAO_SOCIAL=JOEL ACOSTA QUINTANA JUNIOR DESENVOLVIMENTO DE PROGRAMAS LTDA - EPP
CONTRATADA_CNPJ=63.741.075/0001-43
CONTRATADA_ENDERECO=Campo Grande/MS
CONTRATADA_REPRESENTANTE=Joel Acosta Quintana Junior
CONTRATADA_CPF=
DEFAULT_CITY_FORUM=Campo Grande/MS
